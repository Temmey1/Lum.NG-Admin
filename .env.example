# Backend API base URL
# Change to your deployed backend URL in production.
# This is the ONLY thing that ties the admin app to the backend —
# the admin app has no dependency on the storefront app at all.
VITE_API_URL=http://localhost:3001

# URL of the separately-deployed storefront app — used only for the
# "View Site" / "Preview Shop" links in the sidebar.
VITE_STOREFRONT_URL=https://lumngstore.vercel.app/
